# Backend
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Web Search & Acquisition (Optional)
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=2000000

# Multi-Source Information Acquisition
API_SOURCE_ENABLED=true
API_SOURCE_URL=https://api.frankfurter.app/latest?from=USD
MODEL_KNOWLEDGE_ENABLED=true
