# Backend
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chai

# Supabase Auth (Optional)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Web Search & Acquisition (Optional)
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=2000000

# Multi-Source Information Acquisition
API_SOURCE_ENABLED=true
API_SOURCE_URL=https://api.frankfurter.app/latest?from=USD
MODEL_KNOWLEDGE_ENABLED=true

# Voice Subsystem (STT & TTS)
STT_PROVIDER=gemini
TTS_PROVIDER=auto
GEMINI_STT_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
